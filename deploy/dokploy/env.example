CONFIG_SOURCE=env
AUTH_ACCESS_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_EXPIRE=604800
WEBSOCKET_PUBLIC_URL=wss://api.example.com/ws
LOG_LEVEL=info
LOG_STAT=false
TZ=Asia/Shanghai

# Infrastructure: replace hostnames with the values shown by your Dokploy environment.
MYSQL_HOST=whetstone-mysql-xxxxxx
MYSQL_PORT=3306
MYSQL_DATABASE=whetstone
MYSQL_USER=whetstone
MYSQL_PASSWORD=replace-in-dokploy-only

REDIS_ADDR=whetstone-redis-xxxxxx:6379
REDIS_PASSWORD=replace-in-dokploy-only

QDRANT_URL=http://whetstone-qdrant:6333
QDRANT_API_KEY=replace-in-dokploy-only

MINIO_ENDPOINT=http://whetstone-minio:9000
MINIO_ACCESS_KEY=replace-in-dokploy-only
MINIO_SECRET_KEY=replace-in-dokploy-only
MINIO_BUCKET=whetstone
MINIO_USE_SSL=false

# Resume files are uploaded by app-apis to a private Alibaba Cloud OSS bucket.
OSS_REGION=cn-hangzhou
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=replace-with-private-bucket
OSS_ACCESS_KEY_ID=replace-in-dokploy-only
OSS_ACCESS_KEY_SECRET=replace-in-dokploy-only
OSS_OBJECT_URL_PREFIX=https://replace-with-bucket-or-custom-domain
