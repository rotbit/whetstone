syntax = "v1"

info (
	title:   "whetstone app apis"
	desc:    "统一应用网关：认证 / 用户 / 简历 / JD / 订单 / 面试 / WebSocket"
	author:  "yourname"
	version: "v0.1"
)

type (
	HealthResp {
		Status string `json:"status"`
	}
	RegisterReq {
		Phone    string `json:"phone"`
		Password string `json:"password"`
	}
	LoginReq {
		Phone    string `json:"phone"`
		Password string `json:"password"`
	}
	TokenResp {
		AccessToken string `json:"accessToken"`
		ExpireAt    int64  `json:"expireAt"`
	}
	UserInfoResp {
		Id      int64  `json:"id"`
		Phone   string `json:"phone"`
		Plan    string `json:"plan"`
		Credits int64  `json:"credits"`
	}
	UploadResumeResp {
		ResumeId   int64  `json:"resumeId"`
		ParseState string `json:"parseState"` // parsing | done | failed
	}
	ResumeResp {
		ResumeId   int64  `json:"resumeId"`
		ParsedJson string `json:"parsedJson"` // 结构化简历（项目/技能/经历）
		ParseState string `json:"parseState"`
	}
	SaveJdReq {
		Title   string `json:"title"`
		Content string `json:"content"`
	}
	SaveJdResp {
		JdId int64 `json:"jdId"`
	}
	CreateOrderReq {
		Sku string `json:"sku"` // pack_3 | monthly
	}
	CreateOrderResp {
		OutTradeNo string `json:"outTradeNo"`
		PayUrl     string `json:"payUrl"`
	}
	CreateSessionReq {
		Position string `json:"position"` // 目标岗位，如 go-backend
		Mode     string `json:"mode,default=text"` // text | voice（M2）
		ResumeId int64  `json:"resumeId,optional"`
		JdId     int64  `json:"jdId,optional"`
	}
	CreateSessionResp {
		SessionId string `json:"sessionId"`
		WsUrl     string `json:"wsUrl"`
	}
	SessionItem {
		SessionId string `json:"sessionId"`
		Position  string `json:"position"`
		Mode      string `json:"mode"`
		State     string `json:"state"` // ongoing | finished | reported
		StartedAt int64  `json:"startedAt"`
	}
	ListSessionsReq {
		Page     int `form:"page,default=1"`
		PageSize int `form:"pageSize,default=10"`
	}
	ListSessionsResp {
		Total int64         `json:"total"`
		List  []SessionItem `json:"list"`
	}
	GetReportReq {
		SessionId string `path:"sessionId"`
	}
	QaItem {
		Seq      int    `json:"seq"`
		Question string `json:"question"`
		Answer   string `json:"answer"`
		Score    int    `json:"score"`
		Feedback string `json:"feedback"`
	}
	GetReportResp {
		State       string   `json:"state"` // generating | done
		Summary     string   `json:"summary"`
		RadarJson   string   `json:"radarJson"`
		Suggestions string   `json:"suggestions"`
		Items       []QaItem `json:"items"`
	}
)

@server (
	group: system
)
service app-api {
	@handler health
	get /healthz returns (HealthResp)
}

@server (
	prefix: /api/v1/auth
	group:  auth
)
service app-api {
	@handler register
	post /register (RegisterReq) returns (TokenResp)

	@handler login
	post /login (LoginReq) returns (TokenResp)
}

@server (
	prefix: /api/v1
	group:  user
	jwt:    Auth
)
service app-api {
	@handler userInfo
	get /user/info returns (UserInfoResp)

	// multipart/form-data 文件上传，handler 内自行读取 r.MultipartForm。
	@handler uploadResume
	post /resume/upload returns (UploadResumeResp)

	@handler getResume
	get /resume returns (ResumeResp)

	@handler saveJd
	post /jd (SaveJdReq) returns (SaveJdResp)

	@handler createOrder
	post /orders (CreateOrderReq) returns (CreateOrderResp)
}

@server (
	prefix: /api/v1/interview
	group:  interview
	jwt:    Auth
)
service app-api {
	@handler createSession
	post /sessions (CreateSessionReq) returns (CreateSessionResp)

	@handler listSessions
	get /sessions (ListSessionsReq) returns (ListSessionsResp)

	@handler getReport
	get /sessions/:sessionId/report (GetReportReq) returns (GetReportResp)
}

// WebSocket 在同一个 app-apis 进程中升级连接；JWT 与 sessionId 由 handler 校验。
@server (
	group: websocket
)
service app-api {
	@handler websocket
	get /ws
}
