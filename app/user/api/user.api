syntax = "v1"

info (
	title:   "whetstone user api"
	desc:    "用户域对外接口：认证 / 简历 / JD / 次数 / 订单"
	author:  "yourname"
	version: "v0.1"
)

type (
	RegisterReq {
		Phone    string `json:"phone"`
		Code     string `json:"code"`
		Password string `json:"password,optional"`
	}
	LoginReq {
		Phone    string `json:"phone"`
		Password string `json:"password"`
	}
	TokenResp {
		AccessToken string `json:"accessToken"`
		ExpireAt    int64  `json:"expireAt"`
	}
	UserInfoResp {
		Id      int64  `json:"id"`
		Phone   string `json:"phone"`
		Plan    string `json:"plan"`
		Credits int64  `json:"credits"`
	}
	UploadResumeResp {
		ResumeId   int64  `json:"resumeId"`
		ParseState string `json:"parseState"` // parsing | done | failed
	}
	ResumeResp {
		ResumeId   int64  `json:"resumeId"`
		ParsedJson string `json:"parsedJson"` // 结构化简历（项目/技能/经历）
		ParseState string `json:"parseState"`
	}
	SaveJdReq {
		Title   string `json:"title"`
		Content string `json:"content"`
	}
	SaveJdResp {
		JdId int64 `json:"jdId"`
	}
	CreateOrderReq {
		Sku string `json:"sku"` // pack_3 | monthly
	}
	CreateOrderResp {
		OutTradeNo string `json:"outTradeNo"`
		PayUrl     string `json:"payUrl"`
	}
)

@server (
	prefix: /api/v1/auth
	group:  auth
)
service user-api {
	@handler register
	post /register (RegisterReq) returns (TokenResp)

	@handler login
	post /login (LoginReq) returns (TokenResp)
}

@server (
	prefix: /api/v1
	group:  user
	jwt:    Auth
)
service user-api {
	@handler userInfo
	get /user/info returns (UserInfoResp)

	// multipart/form-data 文件上传，handler 内自行读 r.MultipartForm
	@handler uploadResume
	post /resume/upload returns (UploadResumeResp)

	@handler getResume
	get /resume returns (ResumeResp)

	@handler saveJd
	post /jd (SaveJdReq) returns (SaveJdResp)

	@handler createOrder
	post /orders (CreateOrderReq) returns (CreateOrderResp)
}
