syntax = "v1"

info (
	title:   "whetstone interview api"
	desc:    "面试域对外接口：会话管理 / 复盘报告"
	author:  "yourname"
	version: "v0.1"
)

type (
	CreateSessionReq {
		Position string `json:"position"`          // 目标岗位，如 go-backend
		Mode     string `json:"mode,default=text"` // text | voice（M2）
		ResumeId int64  `json:"resumeId,optional"`
		JdId     int64  `json:"jdId,optional"`
	}
	CreateSessionResp {
		SessionId string `json:"sessionId"`
		WsUrl     string `json:"wsUrl"` // ws-gateway 连接地址
	}
	SessionItem {
		SessionId string `json:"sessionId"`
		Position  string `json:"position"`
		Mode      string `json:"mode"`
		State     string `json:"state"` // ongoing | finished | reported
		StartedAt int64  `json:"startedAt"`
	}
	ListSessionsReq {
		Page     int `form:"page,default=1"`
		PageSize int `form:"pageSize,default=10"`
	}
	ListSessionsResp {
		Total int64         `json:"total"`
		List  []SessionItem `json:"list"`
	}
	GetReportReq {
		SessionId string `path:"sessionId"`
	}
	QaItem {
		Seq      int    `json:"seq"`
		Question string `json:"question"`
		Answer   string `json:"answer"`
		Score    int    `json:"score"`
		Feedback string `json:"feedback"`
	}
	GetReportResp {
		State       string   `json:"state"` // generating | done
		Summary     string   `json:"summary"`
		RadarJson   string   `json:"radarJson"`
		Suggestions string   `json:"suggestions"`
		Items       []QaItem `json:"items"`
	}
)

@server (
	prefix: /api/v1/interview
	group:  interview
	jwt:    Auth
)
service interview-api {
	@handler createSession
	post /sessions (CreateSessionReq) returns (CreateSessionResp)

	@handler listSessions
	get /sessions (ListSessionsReq) returns (ListSessionsResp)

	@handler getReport
	get /sessions/:sessionId/report (GetReportReq) returns (GetReportResp)
}
